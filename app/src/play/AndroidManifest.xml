<?xml version="1.0" encoding="utf-8"?>
<!--
  Build da Play (`-Pplay`, 16/11/2026): este manifesto entra por cima do principal e TIRA o que a loja não aceita
  num launcher (decisões da venda, memória "DECISÕES DA PLAY/VENDA"). O resto dos poderes fica e vai declarado ao
  revisor (docs/play/notas-ao-revisor.md).
  - REQUEST_INSTALL_PACKAGES: só para app cuja função principal é instalar apps. O launcher não se atualiza (a loja
    atualiza) e o painel instala APK pelo shell próprio (`pm install`, PainelApps.instalarPeloShell).
  - MANAGE_EXTERNAL_STORAGE: só para gerenciador de arquivos/backup. A aba Arquivos e a unidade de rede usam o shell.
  - QUERY_ALL_PACKAGES: o <queries> do principal já cobre os apps da TV (LEANBACK_LAUNCHER) e os pacotes citados;
    abaixo entra também LAUNCHER (apps de celular instalados na TV).
  - USE_EXACT_ALARM: só para app de despertador/agenda como função principal. Fica SCHEDULE_EXACT_ALARM em todas as
    versões ("Alarmes e lembretes", liberado pelo shell próprio); sem ela o alarme toca com folga (Despertador.kt).
  - READ_LOGS / DUMP / WRITE_SECURE_SETTINGS / PACKAGE_USAGE_STATS ficam: só valem se o shell próprio conceder.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:remove="android:maxSdkVersion" />

    <!-- Versão da Play enxuta (18/11/2026, PlayPolicy.kt / docs/play/politicas.md): emprestar o shell (servidor
         Shizuku) e o Device Owner (servidor Dhizuku) a outros apps não existe na loja. Sem estes componentes nenhum
         app de fora chega aos servidores; o código também fica parado (PlayPolicy.Power.LEND_POWERS). -->
    <application>
        <provider android:name=".ProvedorShizuku" tools:node="remove" />
        <activity android:name=".PedidoShizukuActivity" tools:node="remove" />
        <provider android:name=".ProvedorDhizuku" tools:node="remove" />
        <activity android:name=".PedidoDhizukuActivity" tools:node="remove" />
        <service android:name=".ServicoUsuarioDhizuku" tools:node="remove" />
        <!-- Passo 4: a loja atualiza o app. A resposta do PackageInstaller do Atualizador não tem o que receber, e o
             código que baixa e instala APK sai do pacote pelo R8 (Atualizador e PainelApps param em BuildConfig.PLAY). -->
        <receiver android:name=".Atualizador$Resultado" tools:node="remove" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
</manifest>
