{
  "name": "One TV",
  "short_name": "One TV",
  "description": "Controle e administração da TV da sala pelo celular ou computador.",
  "id": "/",
  "start_url": "/#inicio",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#0b0f17",
  "theme_color": "#0b0f17",
  "lang": "pt-BR",
  "icons": [
    { "src": "/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icone-mascaravel.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": { "action": "/", "method": "GET", "params": { "title": "titulo", "text": "texto", "url": "url" } },
  "shortcuts": [
    { "name": "Controle", "url": "/#controle", "icons": [{ "src": "/icone-192.png", "sizes": "192x192" }] },
    { "name": "Arquivos", "url": "/#arquivos", "icons": [{ "src": "/icone-192.png", "sizes": "192x192" }] }
  ]
}
