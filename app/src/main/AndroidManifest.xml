<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV não tem tela de toque -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chip de rede: sinal e velocidade do Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Nome da rede Wi-Fi (SSID): o Android so entrega com permissao de localizacao (concedida por adb, ver README). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Foto do perfil: inicial da conta Google da TV. Liberada uma vez por adb (pm grant) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Ordenar por uso recente: precisa ser liberada uma vez por adb (appops), não aparece como pop-up na TV -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Diagnóstico (04/11/2026): ler os crashes/ANRs de OUTROS apps (DropBoxManager exige READ_LOGS) e o motivo de o
         Android ter fechado cada app (ActivityManager.getHistoricalProcessExitReasons exige DUMP). As duas são de
         "desenvolvimento": o launcher se concede pelo próprio shell (GuardiaoShizuku.autocurar), sem PC. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <!-- Abrir um app quando a TV reinicia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Backup noturno (BackupNoturnoReceiver, teto 10 min) e manutenção noturna (ManutencaoNoturna.kt, teto 3 min): seguram a CPU acordada enquanto rodam. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Atualizador.kt: instalar a versão nova do próprio launcher (Device Owner instala sem perguntar). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Só declarada: permite que o app abra outro app a partir do receiver de boot (ver BootReceiver) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- DNS privado: o launcher grava Settings.Global (tela de DNS). Liberada uma vez por adb: pm grant ... WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Despertador: alarme no horário exato que acorda a TV (AlarmManager.setAlarmClock). USE_EXACT_ALARM vale do Android 13 em diante. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Agenda: ler os eventos (dada uma vez por adb: pm grant ... READ_CALENDAR) e ligar a sincronização da agenda Google -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Painel no navegador (PainelWeb.kt, 04/11/2026). REQUEST_DELETE_PACKAGES: exigida pelo PackageInstaller.uninstall;
         como somos Device Owner, a desinstalação sai sem pedir confirmação na TV. (O painel também usa a QUERY_ALL_PACKAGES
         declarada mais abaixo para listar todos os apps.) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Fase 2 do painel: instalar APK enviado pelo navegador (em silêncio, por sermos Device Owner) e a aba Arquivos.
         MANAGE_EXTERNAL_STORAGE ("acesso a todos os arquivos") não se concede pelo Device Owner: o launcher se concede
         pelo próprio shell na primeira vez (PainelArquivos.garantirAcesso). Sem isso, só enxergaria as pastas dele. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Listar todos os apps instalados: painel no navegador (aba Aplicativos, fichas, permissões por app). Até 12/11/2026
         também servia ao Shizuku sob demanda, que saiu junto com o servidor do Shizuku embutido. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 11+ só deixa um app enxergar outros apps se isso for declarado aqui -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- O launcher do Google (04/11/2026): sem isto o PackageManager diz que ele não existe, e o Home.kt
             (botão HOME pelo serviço de teclas, atalho do painel) achava que ele estava desativado. -->
        <package android:name="com.google.android.apps.tv.launcherx" />
    </queries>

    <!-- android:name: LauncherApp liga o registro local de erros (RegistroErros.kt) em todo processo do app. -->
    <application
        android:name=".LauncherApp"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/rede"
        android:icon="@android:drawable/sym_def_app_icon"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="One TV Launcher"
        android:manageSpaceActivity=".GuardarDadosActivity"
        android:theme="@style/One">

        <!-- Trava do "Limpar dados" sem Device Owner (GuardarDadosActivity.kt): o botão das Configurações abre esta tela
             em vez de apagar. Exportada porque quem a abre é o app de Configurações. -->
        <activity
            android:name=".GuardarDadosActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/One.Translucido" />

        <!-- Rotinas por horário (Rotinas.kt): a tela, a tela invisível que acorda a TV, e o receiver do alarme
             (não exportado: só o PendingIntent do próprio launcher chega nele). -->
        <activity
            android:name=".RotinasActivity"
            android:exported="false"
            android:label="@string/lbl_rotinas" />
        <activity
            android:name=".RotinaAcordarActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/One.Translucido" />
        <receiver
            android:name=".RotinaReceiver"
            android:exported="false" />
        <!-- Player universal (06/11/2026): TV ao vivo em processo PRÓPRIO, para um vídeo pesado não derrubar a HOME.
             Exportada só para quem tem DUMP (o adb, para testes); o próprio launcher abre sem precisar dela. -->
        <activity
            android:name=".PlayerActivity"
            android:process=":player"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection"
            android:theme="@style/One.Tela" />
        <!-- Filmes e séries do Xtream (06/11/2026): no mesmo processo do player; só o próprio launcher abre. -->
        <activity
            android:name=".FilmesActivity"
            android:process=":player"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection"
            android:theme="@style/One.Tela" />
        <activity
            android:name=".SeriesActivity"
            android:process=":player"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection"
            android:theme="@style/One.Tela" />
        <!-- Mídias da rede (07/11/2026): servidores UPnP/DLNA da casa; toca na VodActivity. -->
        <activity
            android:name=".MidiaRedeActivity"
            android:process=":player"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection"
            android:theme="@style/One.Tela" />
        <activity
            android:name=".VodActivity"
            android:process=":player"
            android:exported="false"
            android:excludeFromRecents="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection"
            android:theme="@style/One.Tela" />
        <activity
            android:name=".LicencasActivity"
            android:exported="false"
            android:label="@string/lbl_licencas" />
        <activity
            android:name=".DiagnosticoActivity"
            android:exported="false"
            android:label="@string/lbl_diagnostico" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME é o que faz o Android tratar este app como "tela inicial" -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LEANBACK_LAUNCHER deixa abrir pelo menu de apps da TV durante os testes -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- permission=DUMP: o BOOT_COMPLETED vem do sistema (que tem todas as permissões) e o TESTE_BOOT vem do adb.
             Sem isto qualquer app instalado podia disparar o TESTE_BOOT (religar a depuração, abrir app) — revisão 04/11. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Teste do shell proprio (MARCO 2): recebe o codigo de pareamento por adb broadcast (ver PareamentoReceiver) -->
        <!-- permission=DUMP: so o shell (adb) e o sistema tem essa permissao. Sem isto, QUALQUER app instalado na TV
             podia disparar o PAREAR e mandar o launcher abrir um shell. -->
        <receiver
            android:name=".PareamentoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="br.paulo.tvlauncher.PAREAR" />
            </intent-filter>
        </receiver>
        <!-- Serviço de acessibilidade: hoje só trata as teclas do controle remoto (ver AutorizaShizukuService.kt) -->
        <service
            android:name=".AutorizaShizukuService"
            android:exported="false"
            android:label="@string/lbl_teclas"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autoriza_acessibilidade" />
        </service>
        <!-- Lista para escolher o app dos botões Netflix/YouTube do controle (segurar 3 s, ver BotoesControle).
             Tinha sumido do manifest no commit df3d9c0; sem ela, segurar o botão derrubava a HOME
             (ActivityNotFoundException no processo do launcher). Devolvida em 04/11/2026. -->
        <activity
            android:name=".EscolherAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/lbl_escolher_app_botao" />
        <!-- Tela de DNS privado (aberta pelo chip do rodapé) -->
        <activity
            android:name=".DnsActivity"
            android:exported="false"
            android:label="@string/lbl_dns" />
        <!-- "Configurações do launcher": aparência, DNS, teste de velocidade, permissões, diagnóstico (aberta pelo card "Launcher" do popup do perfil) -->
        <!-- Assistente de primeira abertura (só sem Device Owner, uma vez): BoasVindasActivity.kt -->
        <!-- Conectar o Claude (e outros clientes MCP) pela internet: QR codes do Tailscale e do endereço. -->
        <activity
            android:name=".ConectarClaudeActivity"
            android:exported="false"
            android:label="@string/lbl_claude_internet" />
        <activity
            android:name=".EntrarPeloQrActivity"
            android:exported="false"
            android:label="@string/lbl_entrar_celular" />
        <activity
            android:name=".BoasVindasActivity"
            android:exported="false"
            android:label="@string/lbl_bem_vindo" />
        <activity
            android:name=".ConfigLauncherActivity"
            android:exported="false"
            android:label="@string/lbl_config" />
        <!-- Controle parental: escolher os canais bloqueados (só pelas Configurações, depois do PIN). -->
        <activity
            android:name=".BloqueioCanaisActivity"
            android:exported="false"
            android:label="@string/lbl_canais_bloqueados" />
        <!-- Despertador: a lista/editor (abre no OK do relógio) e o "app de despertador" do Android (Gemini: "me acorda às 7"). -->
        <activity
            android:name=".AlarmesActivity"
            android:exported="true"
            android:label="@string/lbl_despertador"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Timer (ver Timer.kt): atende o "criar timer" do Android que o Gemini manda ("Ok Google, timer de 10 minutos").
             Nesta TV o outro que atende é um stub de fábrica com prioridade -1, então o nosso vence sem perguntar. -->
        <activity
            android:name=".TimerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/One.Translucido">
            <intent-filter>
                <action android:name="android.intent.action.SET_TIMER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Contagem por voz (ver TimerActivity). O Gemini desta TV recusa "timer de X minutos" e, para "abrir Contagem de
             1 minuto", buscou vídeos de contagem no YouTube (05/11/2026): palavra de timer vira pedido dele, não "abrir app".
             Por isso o nome copia o formato que funcionou ("Desligar em 30 minutos"): verbo + "em N minutos". -->
        <activity-alias
            android:name=".Avisar5"
            android:exported="true"
            android:label="@string/lbl_avisar5"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Avisar10"
            android:exported="true"
            android:label="@string/lbl_avisar10"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Avisar15"
            android:exported="true"
            android:label="@string/lbl_avisar15"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Avisar20"
            android:exported="true"
            android:label="@string/lbl_avisar20"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Avisar30"
            android:exported="true"
            android:label="@string/lbl_avisar30"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".Ampulheta"
            android:exported="true"
            android:label="@string/lbl_ampulheta"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".NaoAvisar"
            android:exported="true"
            android:label="@string/lbl_nao_avisar"
            android:targetActivity=".TimerActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Previsão do tempo em tela cheia (abre no OK do clima, no topo) -->
        <activity
            android:name=".PrevisaoActivity"
            android:exported="false"
            android:label="@string/lbl_previsao" />
        <!-- "Bom dia": como o Boletim do Tempo, mas fala antes a saudação e a hora e, depois, a agenda de hoje
             ("Ok Google, abrir Bom dia"). É também o que o despertador abre ao apertar Parar (ver AlarmeTocandoActivity). -->
        <activity-alias
            android:name=".BomDia"
            android:exported="true"
            android:label="@string/lbl_bom_dia"
            android:targetActivity=".PrevisaoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- "Boletim do Tempo": um segundo "app" no menu da TV que abre a previsão e a lê em voz alta.
             Existe para o Google Assistant abrir por voz ("Ok Google, abrir Boletim do Tempo"). O launcher não o mostra na linha de apps. -->
        <activity-alias
            android:name=".BoletimDoTempo"
            android:exported="true"
            android:label="@string/lbl_boletim"
            android:targetActivity=".PrevisaoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Atalhos de voz (ver AtalhoVozActivity): cada alias é um "app" com nome falável, para o Gemini abrir
             ("Ok Google, abrir Desligar em 30 minutos"). A tela não desenha nada: faz o comando e fecha. -->
        <activity
            android:name=".AtalhoVozActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/One.Translucido" />
        <activity-alias
            android:name=".VozDesligar30"
            android:exported="true"
            android:label="@string/lbl_desligar30"
            android:targetActivity=".AtalhoVozActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".VozDesligar60"
            android:exported="true"
            android:label="@string/lbl_desligar60"
            android:targetActivity=".AtalhoVozActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".VozNaoDesligar"
            android:exported="true"
            android:label="@string/lbl_nao_desligar"
            android:targetActivity=".AtalhoVozActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".VozDiagnostico"
            android:exported="true"
            android:label="@string/lbl_diagnostico_tv"
            android:targetActivity=".AtalhoVozActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".VozAgenda"
            android:exported="true"
            android:label="@string/lbl_minha_agenda"
            android:targetActivity=".AtalhoVozActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Os dois alarmes do "desligar em X min" (aviso 1 min antes e a hora de apagar). Só o próprio app chama. -->
        <receiver
            android:name=".DesligamentoReceiver"
            android:exported="false" />
        <!-- Agenda do perfil ativo (abre no OK da data do topo) -->
        <activity
            android:name=".CalendarioActivity"
            android:exported="false"
            android:label="@string/lbl_agenda" />
        <!-- A tela que aparece quando o alarme toca: acende a tela mesmo em standby. -->
        <activity
            android:name=".AlarmeTocandoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <!-- Protetor de tela proprio (relogio + clima), leve. Apontamos screensaver_components do sistema para ele,
             aposentando o dreamx (~59 MB). Ver ProtetorTela.kt. -->
        <service
            android:name=".ProtetorTela"
            android:exported="true"
            android:label="@string/lbl_relogio"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Comandos por adb (DUMP: só o adb e o sistema). Os nomes .shizuku.* ficaram por compatibilidade: desde 12/11/2026
             não há mais servidor do Shizuku embutido; INICIAR confere o shell próprio, ESTADO diz se ele responde. -->
        <receiver
            android:name=".ControleShizukuAdbReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="br.paulo.tvlauncher.shizuku.INICIAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.PARAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.ESTADO" />
                <!-- Nomes reais dos apps para o painel do PC (chromecast-painel). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.ROTULOS" />
                <!-- Ocultar/reexibir um app pelo Device Owner (teste e desfazer). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.OCULTAR" />
                <action android:name="br.paulo.tvlauncher.REINICIAR" />
                <!-- Recado na tela e aviso de chuva (teste). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.RECADO" />
                <action android:name="br.paulo.tvlauncher.CHUVA" />
                <action android:name="br.paulo.tvlauncher.UNIFI" />
                <action android:name="br.paulo.tvlauncher.HOME_TESTE" />
                <action android:name="br.paulo.tvlauncher.LOCAL_CLIMA" />
                <!-- Definir o PIN do painel no navegador e ligá-lo (testes). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.PAINEL_PIN" />
                <!-- Registro local de erros: listar e gravar um de teste (05/11/2026). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.ERROS" />
                <action android:name="br.paulo.tvlauncher.TESTE_ERRO" />
                <!-- Rotinas por horário: listar e rodar uma agora (05/11/2026). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.ROTINA" />
                <!-- Limpeza de apps de fábrica: relatório dos candidatos (05/11/2026). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.DEBLOAT" />
                <!-- Pedidos do catálogo: testar a confirmação e ver o último pedido (só adb, ver PedidoIa). -->
                <action android:name="br.paulo.tvlauncher.IA_TESTE" />
                <action android:name="br.paulo.tvlauncher.IA_ESTADO" />
                <!-- Desligar sozinha: ver/definir/testar o aviso (testes). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.AUTO_DESLIGAR" />
                <!-- Player universal: cadastrar/apagar conta e ver o estado (06/11/2026, até o painel ter a aba). -->
                <action android:name="br.paulo.tvlauncher.PLAYER_FONTE" />
                <action android:name="br.paulo.tvlauncher.PLAYER_ESTADO" />
                <!-- Comandos das ideias de 10/11/2026 (ComandosExtras.kt). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.EXTRAS" />
            </intent-filter>
        </receiver>
        <!-- Hora ou fuso mudou (acerto pela rede, horário de verão): reagenda despertadores e rotinas (auditoria 10/11/2026).
             TIME_SET e TIMEZONE_CHANGED estão na lista de exceções: chegam a um receiver declarado no manifesto. -->
        <receiver android:name=".HoraMudouReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Resultado da desinstalação pedida pelo painel no navegador (PainelApps.desinstalar). Não exportado: só o
             PendingIntent do próprio launcher chega aqui. -->
        <receiver
            android:name=".ResultadoDesinstalarReceiver"
            android:exported="false" />

        <!-- Confirmação NA TV de um pedido de ações do catálogo (ver PedidoIa.kt). Só o próprio launcher abre.
             taskAffinity vazio: abre numa tarefa própria. Na tarefa da HOME, ela traria a HOME para a frente e, ao
             fechar, a pessoa cairia na tela inicial em vez de voltar ao app que estava vendo (ex.: "pausa"). -->
        <activity
            android:name=".ConfirmarIaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/One.Translucido" />

        <!-- Pergunta das Confirmações (ConfirmacoesTv): ações de poder com o modo "Perguntar na TV". -->
        <activity
            android:name=".PerguntaTvActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/One.Translucido" />

        <!-- Painel rápido (PainelRapidoActivity, 11/11/2026): por cima de qualquer app, como o painel do Google que ele
             substitui. Tarefa própria (taskAffinity vazio) para não trazer a HOME junto; noHistory: some ao abrir outra tela. -->
        <activity
            android:name=".PainelRapidoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:launchMode="singleTop"
            android:theme="@style/One.Translucido" />

        <!-- Confirmação no controle do "Reconectar a TV" pedido pelo painel (UnifiCliente). Mesma receita da ConfirmarIa. -->
        <activity
            android:name=".ConfirmarRoteadorActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/One.Translucido" />

        <!-- Ideias de 10/11/2026: tela das chaves novas, testador de teclas e padrões de calibração (não exportadas). -->
        <activity android:name=".ExtrasActivity" android:exported="false" android:excludeFromRecents="true" />
        <!-- Backup noturno cifrado (BackupNoturno.kt): a tela de opções e o alarme da noite (não exportados). -->
        <activity android:name=".BackupNoturnoActivity" android:exported="false" android:excludeFromRecents="true" />
        <receiver android:name=".BackupNoturnoReceiver" android:exported="false" />
        <!-- "Tocando agora" (10/11/2026): ler as sessões de mídia exige ser ouvinte de notificações. Só o sistema liga
             (BIND_NOTIFICATION_LISTENER_SERVICE); quem autoriza é o shell próprio (cmd notification allow_listener),
             e só quando a chave TOCANDO_AGORA é ligada em Extras. -->
        <service android:name=".OuvinteNotificacoes" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <activity android:name=".CasaActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".TesteTeclasActivity" android:exported="false" android:excludeFromRecents="true" />
        <activity android:name=".CalibracaoActivity" android:exported="false" android:excludeFromRecents="true"
            android:theme="@style/One.Tela" />

        <!-- Saúde (10/11/2026): aviso "acesso remoto parado" (SaudeAcesso.kt) e o alarme da manutenção noturna
             (ManutencaoNoturna.kt). Nada exportado: só o próprio launcher abre/chama. -->
        <activity android:name=".SaudeAvisoActivity" android:exported="false" android:excludeFromRecents="true"
            android:taskAffinity="" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver android:name=".ManutencaoReceiver" android:exported="false" />

        <!-- Device owner (ver AdminReceiver.kt). Exportado porque o sistema precisa chamá-lo; só o sistema tem BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- Resposta do PackageInstaller para o Atualizador. exported=false: só o sistema (pelo PendingIntent) chega aqui. -->
        <receiver
            android:name=".Atualizador$Resultado"
            android:exported="false" />
        <!-- Ideias de 12/11/2026 (não exportadas). Lembrete da grade: mesma receita da ConfirmarRoteador (por cima do que
             estiver passando, sem entrar nos recentes). Modo simples: a HOME de cards grandes, uma instância só. -->
        <receiver android:name=".LembreteReceiver" android:exported="false" />
        <receiver android:name=".PresencaReceiver" android:exported="false" />
        <receiver android:name=".RetrospectivaReceiver" android:exported="false" />
        <activity
            android:name=".LembreteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:theme="@style/One.Translucido" />
        <activity android:name=".BuscaActivity" android:exported="false" android:excludeFromRecents="true"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ModoSimplesActivity" android:exported="false" android:excludeFromRecents="true"
            android:launchMode="singleTask" />
    </application>
</manifest>
