<?xml version="1.0" encoding="utf-8"?>
<!-- A fonte do launcher inteiro (sistema de design, 10/11/2026): os 4 pesos da Manrope como uma família só.
     O tema do app aponta para cá, então todo texto criado sem fonte própria já sai em Manrope 400;
     "negrito" cai no peso mais perto de 700, que é o 600. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="200" android:font="@font/manrope_200" />
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/manrope_400" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/manrope_500" />
    <font android:fontStyle="normal" android:fontWeight="600" android:font="@font/manrope_600" />
</font-family>
