<?xml version="1.0" encoding="utf-8"?>
<!-- A fonte do launcher inteiro (visual Cinema+, 17/11/2026): Nunito, a mesma do painel web e da marca Sofaly.
     Pesos fixos tirados da Nunito variável oficial (google/fonts, OFL) com todas as letras (latim estendido, cirílico).
     O tema do app aponta para cá: texto sem fonte própria sai no 600; "negrito" cai no 800. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/nunito_600" />
    <font android:fontStyle="normal" android:fontWeight="500" android:font="@font/nunito_700" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/nunito_800" />
</font-family>
